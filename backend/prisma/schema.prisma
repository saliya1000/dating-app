datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  username   String
  profilePic String?
  bio        String?
  createdAt  DateTime @default(now())

  userBio             UserBio?
  sentConnections     Connection[] @relation("RequestSent")
  receivedConnections Connection[] @relation("RequestReceived")
}

model UserBio {
  id        Int    @id @default(autoincrement())
  user      User   @relation(fields: [userId], references: [id])
  userId    Int    @unique
  interest1 String
  interest2 String
  interest3 String
  music     String
  hobby     String
}

model Connection {
  id          Int      @id @default(autoincrement())
  requester   User     @relation("RequestSent", fields: [requesterId], references: [id])
  requesterId Int
  recipient   User     @relation("RequestReceived", fields: [recipientId], references: [id])
  recipientId Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

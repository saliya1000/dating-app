datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  username   String
  profilePic String?
  bio        String?
  latitude   Float?
  longitude  Float?
  lastSeen   DateTime? @default(now())
  createdAt  DateTime @default(now())
  
  // Admin fields
  role       String   @default("USER") // USER, ADMIN
  isBanned   Boolean  @default(false)
  isActive   Boolean  @default(true)
  deletedAt  DateTime?

  userBio             UserBio?
  sentConnections     Connection[] @relation("requester")
  receivedConnections Connection[] @relation("recipient")
  sentMessages        Message[]    @relation("sender")
  receivedMessages    Message[]    @relation("recipient")
  dismissals          Dismissal[]  @relation("dismisser")
  dismissedBy         Dismissal[]  @relation("dismissed")
  
  sentReports         Report[]     @relation("reporter")
  receivedReports     Report[]     @relation("reported")
}

model Report {
  id          Int      @id @default(autoincrement())
  reporterId  Int
  reportedId  Int
  reason      String
  details     String?
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())
  
  reporter    User     @relation("reporter", fields: [reporterId], references: [id])
  reported    User     @relation("reported", fields: [reportedId], references: [id])
}

model UserBio {
  id          Int     @id @default(autoincrement())
  user        User    @relation(fields: [userId], references: [id])
  userId      Int     @unique
  interest1   String
  interest2   String
  interest3   String
  music       String
  hobby       String
  maxDistance Int?
  prefInterest String? // What they are looking for (matches against interest1/2/3)
  prefMusic    String? // What music they want their match to like
  prefHobby    String? // What hobby they want their match to have
}

model Connection {
  id          Int      @id @default(autoincrement())
  requester   User     @relation("requester", fields: [requesterId], references: [id])
  requesterId Int
  recipient   User     @relation("recipient", fields: [recipientId], references: [id])
  recipientId Int
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  messages    Message[]
}

model Message {
  id          Int      @id @default(autoincrement())
  connection  Connection @relation(fields: [connectionId], references: [id])
  connectionId Int
  sender      User     @relation("sender", fields: [senderId], references: [id])
  senderId    Int
  recipient   User     @relation("recipient", fields: [recipientId], references: [id])
  recipientId Int
  content     String
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
}

model Dismissal {
  id          Int      @id @default(autoincrement())
  dismisser   User     @relation("dismisser", fields: [dismisserId], references: [id])
  dismisserId Int
  dismissed   User     @relation("dismissed", fields: [dismissedId], references: [id])
  dismissedId Int
  createdAt   DateTime @default(now())

  @@unique([dismisserId, dismissedId])
}
